<section>
    <div class="container-fluid mt-3">
        <h6>Busce por novos projetos</h6>
        <form>
            <div class="d-flex gap-3 mb-3">
                <input type="text" class="form-control form-control" placeholder="Buscar novos projetos/clientes" aria-label="Username" aria-describedby="basic-addon1">
                <button class="btn btn-primary" type="button">Pesquisar</button>
            </div>

            <div class="d-flex flex-row-reverse align-items-center gap-2 mb-3">
                <div>
                    <span class="form-text">Orçamento: </span>
                    <div class="d-flex gap-2">
                        <div class="input-group">
                          <span class="input-group-text">R$</span>
                          <input class="form-control" id="budget-min" type="number" placeholder="Mínimo">
                        </div>
                        <div class="input-group">
                          <span class="input-group-text">R$</span>
                          <input class="form-control" id="budget-max" type="number" placeholder="Máximo">
                        </div>
                    </div>
                </div>

                <div>
                    <span class="form-text">Prazo: </span>
                    <select class="form-select" aria-label="Filtro de expectativa de tempo">
                        <option selected value="all">Todos</option>
                        <option value="1 day">1 Dia</option>
                        <option value="1 week">1 Semana</option>
                        <option value="1 month">1 Mes</option>
                        <option value="3 months">3 Meses</option>
                        <option value="6 months">6 Meses</option>
                        <option value="1 Ano">1 Ano</option>
                    </select>
                </div>

                <div>
                    <span class="form-text">Plataforma: </span>
                    <div class="d-flex flex-wrap gap-3">
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="platforms" value="Web" id="platform-web" checked>
                        <label class="form-check-label" for="platform-web">Web</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="platforms" value="Desktop" id="platform-desktop">
                        <label class="form-check-label" for="platform-desktop">Desktop</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="platforms" value="Mobile" id="platform-mobile">
                        <label class="form-check-label" for="platform-mobile">Mobile</label>
                      </div>
                    </div
                </div>
            </div>
        </form>
    </div>
</section>

<hr class="text-body-tertiary">

<section class="mb-3">
    <div class="container-fluid">
        <h2>Projetos</h2>
        <div class="d-flex flex-column gap-3">
            <div class="card shadow-sm hover-shadow transition" style="width: 18rem;">
                <div class="card-header bg-light-subtle">
                    <div class="d-flex align-items-center justify-content-between w-100">
                        <h5 class="card-title">Lorem Ipsum</h5>
                        <div class="badge text-bg-primary fw-bold text-uppercase" id="preview-category">Website</div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="small text-muted" id="preview-deadline">Prazo: 1 Mês</div>
                    <p class="card-text text-body mb-3" id="preview-problem">
                      <em>Nenhum problema informado ainda. Responda ao questionário para visualizar o resumo aqui.</em>
                    </p>
                    <ul class="list-group list-group-flush small mb-3">
                        <li class="list-group-item px-0 d-flex justify-content-between">
                          <span class="text-muted">Público-alvo:</span>
                          <span class="fw-semibold text-end" id="preview-platforms">Clientes</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between">
                            <span class="text-muted">Plataformas:</span>
                            <span class="fw-semibold text-end" id="preview-platforms">Web</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between">
                            <span class="text-muted">Linguagem:</span>
                            <span class="fw-semibold text-end" id="preview-language">Python</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between">
                            <span class="text-muted">Orçamento:</span>
                            <span class="fw-semibold text-end text-success" id="preview-budget">A definir</span>
                        </li>
                    </ul>
                </div>
                <div class="card-footer bg-light-subtle">
                    <div class="d-flex align-items-center flex-row-reverse">
                        <button type="button" class="btn"><i class="bi bi-bookmark"></i></button>
                        <span>Salvar</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
