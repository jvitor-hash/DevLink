<section class="py-5 grid-background" style="background-color: #16324A;">
  <div class="container">
    <div class="mb-5 max-w-3xl mx-auto">
      <span class="text-primary fw-semibold tracking-wide fs-7" style="font-family: IBM Plex Mono;">Como funciona</span>
      <h2 class="text-white fw-bold mt-2 mb-3">Três etapas, nenhuma exige saber programar</h2>
      <p class="text-white lead fs-6" style="max-width: 650px;">
        Você não precisa conhecer termos técnicos. As perguntas são objetivas e o sistema organiza tudo no formato ideal que um desenvolvedor precisa.
      </p>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
      <div class="col">
        <div class="card h-100 border-0 shadow-sm p-2 hover-shadow transition">
          <div class="card-body">
            <span class="badge text-bg-primary fw-bold mb-3 px-3 py-2 fs-6">01</span>
            <h5 class="card-title fw-bold">Responda o questionário</h5>
            <p class="card-text text-muted">Perguntas curtas, de múltipla escolha ou resposta livre, organizadas por tema — da ideia ao orçamento.</p>
          </div>
        </div>
      </div>

      <div class="col">
        <div class="card h-100 border-0 shadow-sm p-2 hover-shadow transition">
          <div class="card-body">
            <span class="badge text-bg-primary fw-bold mb-3 px-3 py-2 fs-6">02</span>
            <h5 class="card-title fw-bold">Transforme em especificação</h5>
            <p class="card-text text-muted">O sistema organiza automaticamente todas as suas respostas em um documento técnico e estruturado.</p>
          </div>
        </div>
      </div>

      <div class="col">
        <div class="card h-100 border-0 shadow-sm p-2 hover-shadow transition">
          <div class="card-body">
            <span class="badge text-bg-primary fw-bold mb-3 px-3 py-2 fs-6">03</span>
            <h5 class="card-title fw-bold">Publique seu projeto</h5>
            <p class="card-text text-muted">Após responder todas as etapas, seu projeto estará pronto para ser publicado e orçado.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Questionario -->
<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-8 col-xl-7">
        <form id="questionario-form">
          <div class="card border shadow-sm p-3 p-md-4">
            <div class="card-body">
              <span class="text-primary fw-semibold fs-7" style="font-family: IBM Plex Mono;">Questionário guiado</span>
              <h3 class="fw-bold mt-1 mb-2">Descreva sua ideia com suas palavras</h3>
              <p class="text-muted mb-4 fs-6">Leva cerca de 5 minutos. Você pode voltar e revisar qualquer resposta antes de gerar o briefing final.</p>

              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small fw-semibold text-muted">Progresso</span>
                <span class="small fw-bold text-primary" id="step-indicator">Etapa 1 de 3</span>
              </div>
              <div class="progress mb-4" style="height: 8px;">
                <div class="progress-bar rounded-pill" id="step-progress-bar" role="progressbar" style="width: 33.33%;" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100"></div>
              </div>

              <!-- Pagina 1 -->
              <div id="page-1" class="form-step">
                <div class="mb-3">
                    <p class="m-0">Qual sera o título do seu projeto?</p>
                    <input type="text" class="form-control" placeholder="Digite o titulo do seu projeto...">
                </div>

                <div class="mb-3">
                  <label for="category" class="form-label fw-semibold">Em qual categoria este projeto se encaixa?</label>
                  <select id="category" class="form-select form-select-lg fs-6" required>
                    <option value="web" selected>Website</option>
                    <option value="apps">Desenvolvimento de App</option>
                    <option value="mobile">Plataforma Mobile</option>
                    <option value="cybersecurity">Suporte e Cibersegurança</option>
                    <option value="web3">Blockchain & Web3</option>
                  </select>
                </div>

                <div class="mb-3">
                  <label for="subcategory" class="form-label fw-semibold">Escolha uma sub-categoria</label>
                  <select id="subcategory" class="form-select form-select-lg fs-6" required>
                    <option value="landing" selected>Landing Page</option>
                    <option value="ecommerce">E-commerce</option>
                    <option value="saas">SaaS / Sistema Web</option>
                  </select>
                </div>

                <div class="mb-3">
                  <label for="problem" class="form-label fw-semibold">Qual problema você quer resolver com esse projeto?</label>
                  <textarea id="problem" class="form-control" rows="3" placeholder="Descreva brevemente o problema..." required></textarea>
                </div>

                <div class="mb-3">
                  <label for="target-audience" class="form-label fw-semibold">Qual é o público-alvo deste projeto?</label>
                  <select id="target-audience" class="form-select form-select-lg fs-6" required>
                    <option value="me">Pessoal</option>
                    <option value="clients" selected>Clientes</option>
                    <option value="team">Minha equipe</option>
                    <option value="public">Público em geral</option>
                  </select>
                </div>
              </div>

              <!-- Pagina 2 -->
              <div id="page-2" class="form-step d-none">
                <div class="mb-4">
                  <label class="form-label fw-semibold d-block">Em qual plataforma este projeto será desenvolvido?</label>
                  <div class="d-flex flex-wrap gap-3">
                    <div class="form-check form-check-inline">
                      <input class="form-check-input" type="checkbox" name="platforms" value="Web" id="platform-web" checked>
                      <label class="form-check-label" for="platform-web">Web</label>
                    </div>
                    <div class="form-check form-check-inline">
                      <input class="form-check-input" type="checkbox" name="platforms" value="Desktop" id="platform-desktop">
                      <label class="form-check-label" for="platform-desktop">Desktop</label>
                    </div>
                    <div class="form-check form-check-inline">
                      <input class="form-check-input" type="checkbox" name="platforms" value="Mobile" id="platform-mobile">
                      <label class="form-check-label" for="platform-mobile">Mobile</label>
                    </div>
                  </div>
                </div>

                <div class="mb-4">
                  <label for="programming-language" class="form-label fw-semibold">Qual linguagem de programação será usada?</label>
                  <select class="form-select" name="programmingLanguage" id="programming-language">
                      <option value="python" selected>Python</option>
                      <option value="javascript">Javascript</option>
                      <option value="java">Java</option>
                      <option value="csharp">C#</option>
                      <option value="cpp">C++</option>
                      <option value="typescript">Typescript</option>
                      <option value="c">C</option>
                      <option value="php">PHP</option>
                      <option value="go">Go (Golang)</option>
                      <option value="rust">Rust</option>
                      <option value="kotlin">Kotlin</option>
                      <option value="swift">Swift</option>
                      <option value="ruby">Ruby</option>
                      <option value="dart">Dart</option>
                      <option value="scala">Scala</option>
                      <option value="r">R</option>
                      <option value="lua">Lua</option>
                      <option value="objectivec">Objective-C</option>
                      <option value="perl">Perl</option>
                      <option value="haskell">Haskell</option>
                  </select>
                </div>

                <div class="mb-4">
                  <label class="form-label fw-semibold d-block">Precisa funcionar sem internet em algum momento?</label>
                  <div class="d-flex gap-4">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="internet" id="internet-yes" value="Sim">
                      <label class="form-check-label" for="internet-yes">Sim</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="internet" id="internet-no" value="Não" checked>
                      <label class="form-check-label" for="internet-no">Não</label>
                    </div>
                  </div>
                </div>

                <div class="mb-4">
                  <label class="form-label fw-semibold d-block">Vai ter algum painel administrativo para gerenciar o conteúdo?</label>
                  <div class="d-flex gap-4">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="adminPanel" id="admin-yes" value="Sim" checked>
                      <label class="form-check-label" for="admin-yes">Sim</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="adminPanel" id="admin-no" value="Não">
                      <label class="form-check-label" for="admin-no">Não</label>
                    </div>
                  </div>
                </div>

                <div class="mb-4">
                  <label class="form-label fw-semibold d-block">As pessoas vão precisar criar uma conta ou fazer login?</label>
                  <div class="d-flex gap-4">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="loginSys" id="login-yes" value="Sim" checked>
                      <label class="form-check-label" for="login-yes">Sim</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="loginSys" id="login-no" value="Não">
                      <label class="form-check-label" for="login-no">Não</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="loginSys" id="login-maybe" value="Talvez">
                      <label class="form-check-label" for="login-maybe">Talvez</label>
                    </div>
                  </div>
                </div>

                <div class="mb-4">
                  <label class="form-label fw-semibold d-block">Vai envolver pagamento dentro do sistema?</label>
                  <div class="d-flex gap-4">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="payment" id="payment-yes" value="Sim">
                      <label class="form-check-label" for="payment-yes">Sim</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="payment" id="payment-no" value="Não" checked>
                      <label class="form-check-label" for="payment-no">Não</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="payment" id="payment-maybe" value="Talvez">
                      <label class="form-check-label" for="payment-maybe">Talvez</label>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Pagina 3 -->
              <div id="page-3" class="form-step d-none">
                <div class="mb-4">
                  <label for="user-actions" class="form-label fw-semibold">O que o usuário precisa conseguir fazer?</label>
                  <textarea id="user-actions" class="form-control" rows="3" placeholder="Ex: Cadastrar produtos, exportar relatórios em PDF..." required></textarea>
                </div>

                <div class="mb-4">
                  <label for="visual-style" class="form-label fw-semibold">Você tem alguma cor ou estilo visual em mente?</label>
                  <input class="form-control" id="visual-style" type="text" placeholder="Ex: Tons de azul, estilo minimalista e moderno">
                </div>

                <div class="mb-4">
                  <label for="inspiration" class="form-label fw-semibold">Tem algum site ou app que você quer usar de inspiração?</label>
                  <input class="form-control" id="inspiration" type="text" placeholder="Opcional: Cole links ou nomes de referências">
                </div>

                <div class="mb-4">
                  <label class="form-label fw-semibold d-block">Já tem logo ou identidade visual pronta?</label>
                  <div class="d-flex gap-4">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="branding" id="branding-yes" value="Sim">
                      <label class="form-check-label" for="branding-yes">Sim</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="branding" id="branding-no" value="Não" checked>
                      <label class="form-check-label" for="branding-no">Não</label>
                    </div>
                  </div>
                </div>

                <div class="mb-4">
                  <label for="deadline" class="form-label fw-semibold">Quando você gostaria que estivesse pronto?</label>
                  <select id="deadline" class="form-select form-select-lg fs-6">
                    <option value="1 dia">1 Dia</option>
                    <option value="1 semana">1 Semana</option>
                    <option value="1 mês" selected>1 Mês</option>
                    <option value="3 meses">3 Meses</option>
                    <option value="6 meses">6 Meses</option>
                    <option value="1 ano">1 Ano</option>
                  </select>
                </div>

                <div class="mb-4">
                  <label class="form-label fw-semibold d-block">Valor planejado para investimento (R$)</label>
                  <div class="row g-2">
                    <div class="col-6">
                      <div class="input-group">
                        <span class="input-group-text">R$</span>
                        <input class="form-control" id="budget-min" type="number" placeholder="Mínimo">
                      </div>
                    </div>
                    <div class="col-6">
                      <div class="input-group">
                        <span class="input-group-text">R$</span>
                        <input class="form-control" id="budget-max" type="number" placeholder="Máximo">
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="d-flex justify-content-between pt-3 border-top mt-4">
                <button type="button" id="btn-prev" class="btn btn-secondary px-4 fw-medium" disabled>Voltar</button>
                <button type="button" id="btn-next" class="btn btn-primary px-4 fw-medium">Próximo</button>
              </div>

            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Visualização -->
<section class="py-5 bg-light-subtle">
  {{> ticket_extended}}
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    let currentStep = 1;
    const totalSteps = 3;

    const btnNext = document.getElementById('btn-next');
    const btnPrev = document.getElementById('btn-prev');
    const stepIndicator = document.getElementById('step-indicator');
    const progressBar = document.getElementById('step-progress-bar');
    const form = document.getElementById('questionario-form');

    // Navigation logic
    function updateStep(step) {
      document.querySelectorAll('.form-step').forEach((el, index) => {
        el.classList.toggle('d-none', index + 1 !== step);
      });

      btnPrev.disabled = step === 1;
      btnNext.textContent = step === totalSteps ? 'Concluir' : 'Próximo';

      stepIndicator.textContent = `Etapa ${step} de ${totalSteps}`;
      const progressPercent = (step / totalSteps) * 100;
      progressBar.style.width = `${progressPercent}%`;
      progressBar.setAttribute('aria-valuenow', progressPercent);
    }

    btnNext.addEventListener('click', () => {
      if (currentStep < totalSteps) {
        currentStep++;
        updateStep(currentStep);
      } else {
        alert('Formulário enviado com sucesso!');
      }
    });

    btnPrev.addEventListener('click', () => {
      if (currentStep > 1) {
        currentStep--;
        updateStep(currentStep);
      }
    });

    // Real-time Preview Sync
    function updatePreview() {
      // Category & Subcategory
      const categorySelect = document.getElementById('category');
      const subcategorySelect = document.getElementById('subcategory');
      const categoryText = categorySelect.options[categorySelect.selectedIndex]?.text || '';
      const subcategoryText = subcategorySelect.options[subcategorySelect.selectedIndex]?.text || '';

      document.getElementById('preview-category').textContent = categoryText;
      document.getElementById('preview-title').textContent = `${subcategoryText}`;

      // Problem description
      const problemVal = document.getElementById('problem').value.trim();
      document.getElementById('preview-problem').innerHTML = problemVal
        ? problemVal.replace(/\n/g, '<br>')
        : '<em>Nenhum problema informado ainda. Responda ao questionário para visualizar o resumo aqui.</em>';

      // Publico-Alvo
      const audienceSelect = document.getElementById('target-audience');
      document.getElementById('preview-public').textContent = audienceSelect.options[audienceSelect.selectedIndex]?.text || 'N/A';

      // Platforms (Checkboxes)
      const checkedPlatforms = Array.from(document.querySelectorAll('input[name="platforms"]:checked'))
        .map(cb => cb.value);
      document.getElementById('preview-platforms').textContent = checkedPlatforms.length ? checkedPlatforms.join(', ') : 'Nenhuma';

      // Programming Language
      const langSelect = document.getElementById('programming-language');
      document.getElementById('preview-language').textContent = langSelect.options[langSelect.selectedIndex]?.text || 'N/A';

      // Deadline
      const deadlineSelect = document.getElementById('deadline');
      document.getElementById('preview-deadline').textContent = `Prazo: ${deadlineSelect.options[deadlineSelect.selectedIndex]?.text || 'N/A'}`;

      // Budget
      const minBudget = document.getElementById('budget-min').value;
      const maxBudget = document.getElementById('budget-max').value;
      let budgetText = 'A definir';
      if (minBudget && maxBudget) {
        budgetText = `R$ ${minBudget} - R$ ${maxBudget}`;
      } else if (minBudget) {
        budgetText = `A partir de R$ ${minBudget}`;
      } else if (maxBudget) {
        budgetText = `Até R$ ${maxBudget}`;
      }
      document.getElementById('preview-budget').textContent = budgetText;

      // User Actions
      const actionsVal = document.getElementById('user-actions').value.trim();
      document.getElementById('preview-actions').textContent = actionsVal || 'Ainda não especificado.';
    }

    // Attach real-time listeners to all form fields
    form.addEventListener('input', updatePreview);
    form.addEventListener('change', updatePreview);

    // Initial render call
    updatePreview();
  });
</script>
