{{> modal_login}}

<script>
  const html = document.documentElement;
  const button = $('#dark-mode-toggle');
  const icon = $('#theme-icon');

  function CleanUpLocalstorage() {
    localStorage.setItem("signedIn", "false");
    localStorage.removeItem("AccessToken");
    localStorage.removeItem("username");

    ShowSignedOut();
  }

  async function UpdateAuthUI() {
    const isLoggedIn = localStorage.getItem("signedIn") !== "false";

    if (!isLoggedIn || isLoggedIn === null) {
        ShowSignedOut();
        return;
    }

    ShowSignedIn();
  }

  function ShowSignedIn() {
    const username = localStorage.getItem("username");
    $('#signed-out').addClass('d-none');
    $('#signed-in').removeClass('d-none');

    $('#username-text').text(username);
  }

  function ShowSignedOut() {
    $('#signed-in').addClass('d-none');
    $('#signed-out').removeClass('d-none');
  }

  function SetTheme(theme) {
    html.setAttribute('data-bs-theme', theme);

    icon.attr(
      'class',
      theme === 'dark' ? 'bi bi-sun' : 'bi bi-moon'
    );

    localStorage.setItem('theme', theme);
  }

  const savedTheme = localStorage.getItem('theme') || 'light';
  SetTheme(savedTheme);

  $('#disconnect-button').on('click', async () => {
    API.post('/api/usuario/logout')
      .done(function (response) {
        CleanUpLocalstorage();
      })
      .fail(function (xhr) {
        console.error("Falha ao fazer logout: ", xhr.responseJSON);
        CleanUpLocalstorage();
      });


    window.location.href = '/';
  });

  button.on('click', () => {
    const currentTheme = html.getAttribute('data-bs-theme') || "light";
    SetTheme(currentTheme === 'dark' ? 'light' : 'dark');
  });

  UpdateAuthUI();
</script>
