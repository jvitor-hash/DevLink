  <div class="container-fluid">
    <span class="navbar-brand" href="#">DevLink</span>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/questionario">Questionário</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/projetos">Projetos</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#">Teste - 3</a>
        </li>
      </ul>

      <div id="signed-in" class="d-none d-flex flex-row align-items-center">
        <a href="/notificacao" class="btn"><i class="bi bi-bell"></i></a>
        <button id="dark-mode-toggle" type="button" class="btn"><i id="theme-icon" class="bi bi-moon"></i></button>
        <a href="/perfil" class="text-body" style="text-decoration: none;"><span id="username-text">test</span></a>
        <div class="dropdown">
          <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"></button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a href="/config" class="dropdown-item">Configuracoes</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><button class="dropdown-item text-danger" id="disconnect-button" type="button">Desconetar-se</button></li>
          </ul>
        </div>
      </div>


      <div id="signed-out" class="d-none">
        <button id="dark-mode-toggle" type="button" class="btn"><i id="theme-icon" class="bi bi-moon"></i></button>
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#login_modal">Login</button>
      </div>
    </div>
  </div>
</nav>

{{> modal_login}}

<script>
  const button = $('#dark-mode-toggle');
  const icon = $('#theme-icon');
  const disconnectButton = $('#disconnect-button');

  disconnectButton.on('click', () => {
    localStorage.clear();
    location.reload();
    window.location.href="/";
  });

  button.on('click', () => {
    const html = document.documentElement;
    const isDark = html.getAttribute('data-bs-theme') === 'dark';

    html.setAttribute('data-bs-theme', isDark ? 'light' : 'dark');

    icon.className = isDark
      ? 'bi bi-moon'
      : 'bi bi-sun';
  });


  let signedIn = localStorage.getItem('signedIn');

  if (signedIn === null)
    signedIn = 'false';
    localStorage.setItem('signedIn', signedIn);

  if(signedIn === 'false') {
    const elem = $("#signed-out");
    elem.removeClass("d-none");
  } else if (signedIn === 'true') {
    const elem = $("#signed-in");
    const username = $("#username-text");
    const storedUsername = localStorage.getItem("Username");

    elem.removeClass("d-none");
    if (storedUsername !== null)
      username.text(storedUsername ?? "teste");

  }
</script>
