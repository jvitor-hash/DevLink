<h2 class="p-2 mb-3">Projetos</h2>

<form>
    <div class="input-group mb-3 px-4">
      <input type="text" class="form-control form-control-lg" placeholder="Buscar novos projetos/clientes" aria-label="Username" aria-describedby="basic-addon1">
      <button class="input-group-text" type="button">
          <i class="bi bi-search fs-5 fw-bold"></i>
      </button>
    </div>

    <div class="d-flex flex-row-reverse gap-2 mb-3 mx-4">
        <div>
            <span class="form-text">Orcamento: </span>
            <div class="d-flex gap-2">
                <input class="form-control" type="text" placeholder="Minimo R$ 0">
                <input class="form-control" type="text" placeholder="Maximo R$ 9999">
            </div>
        </div>

        <div>
            <span class="form-text">Expectativa de tempo: </span>
            <select class="form-select" aria-label="Filtro de expectativa de tempo">
                <option selected value="all">Todos</option>
                <option value="1 day">1 Dia</option>
                <option value="1 week">1 Semana</option>
                <option value="1 month">1 Mes</option>
                <option value="3 months">3 Meses</option>
                <option value="6 months">6 Meses</option>
                <option value="1 Ano">1 Ano</option>
            </select>
        </div>

        <div>
            <span class="form-text">Plataforma: </span>
            <select class="form-select" aria-label="Filtro de plataforma">
                <option selected value="web">Web</option>
                <option value="desktop">Desktop</option>
                <option value="mobile">Mobile</option>
            </select>
        </div>
    </div>
</form>

